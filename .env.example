# Copy to .env (not committed) if you use a dotenv loader, or just export.
# Provider is never selected from key presence alone — configure [stt]/[tts] provider explicitly.

# OpenRouter (STT / cleanup / future remote TTS)
OPENROUTER_API_KEY=
# Optional override for tests / proxies:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Other named providers (scoped secrets only; used when that provider is selected)
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# XAI_API_KEY=
